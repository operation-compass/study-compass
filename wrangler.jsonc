{
  "name": "shirunoera",
  "main": "worker.js",
  "compatibility_date": "2026-10-07",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "html_handling": "none",
    "run_worker_first": true
  },
  "analytics_engine_datasets": [
    {
      "binding": "TRAFFIC_ANALYTICS",
      "dataset": "shirunoera_traffic_v1"
    }
  ]
}
